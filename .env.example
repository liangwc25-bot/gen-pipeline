# ── gen-pipeline .env.example ────────────────────────────────────────────────
# Copy this file to `.env` (project root) and fill in your keys.
#   cp .env.example .env
#
# `.env` is git-ignored — never commit real keys.
# Code loads it from the project root (gen_lib/common.py::load_env).
#
# ── Web UI (gen.html / gen_server.py) — required to run the browser UI ──────
# The gen web UI + gallery need at least RUNWARE_API_KEY to function.
RUNWARE_API_KEY=
MODELSLAB_API_KEY=

# ── gen.py CLI extra providers (each optional, only if you use that provider)
# Dispatch: runware / fal / fal-pro / grok / together / replicate / openrouter / modelslab / wan-nsfw
FAL_KEY=
XAI_API_KEY=            # used by gen_lib/grok.py
TOGETHER_API_KEY=
REPLICATE_API_TOKEN=    # also used by gen_lib/i2v_replicate.py (I2V)
OPENROUTER_API_KEY=

# ── I2V via RunPod serverless (gen_lib/i2v_runpod.py) — only if you use runpod-wan
RUNPOD_API_KEY=
RUNPOD_S3_ENDPOINT=      # RunPod S3-compatible endpoint URL
RUNPOD_S3_ACCESS_KEY=
RUNPOD_S3_SECRET_KEY=
RUNPOD_S3_REGION=        # e.g. eu-ro-1 (default)
RUNPOD_NETVOL_ID=        # RunPod network volume id (bucket)

# ── Optional / legacy ────────────────────────────────────────────────────────
# None currently required beyond the above.
